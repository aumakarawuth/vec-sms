# ═══════════════════════════════════════════════════════════════════
# /etc/vecsms/vecsms.env — คัดลอกไฟล์นี้ไปแล้วกรอกค่าจริงบนเซิร์ฟเวอร์
#   sudo install -m 600 -o root -g root vecsms.env.example /etc/vecsms/vecsms.env
# ห้าม commit ไฟล์ที่กรอกแล้ว
#
# สุ่มค่าด้วย:  openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3100
TZ=Asia/Bangkok

# ผู้ใช้ของแอปที่อยู่ในกลุ่ม app_runtime เท่านั้น — ต่อด้วย postgres แล้วแอปไม่บูต
# พอร์ต 5434 คือ cluster ของ vec-sms ไม่ใช่ของ examkub
DATABASE_URL=postgres://vecsms_app:CHANGE_ME@127.0.0.1:5434/vecsms
DB_POOL_MAX=10

JWT_SECRET=CHANGE_ME
IP_HASH_SECRET=CHANGE_ME
PROVISION_KEY=CHANGE_ME

# ─── สองตัวนี้ต้องสำรองไว้นอกเครื่อง ───
# NATIONAL_ID_KEY หาย = ใบ รบ. ที่ออกไปแล้วพิมพ์ซ้ำได้ช่องเลขบัตรว่างตลอดไป
# MFA_SECRET_KEY หาย = admin/director ทุกคนต้องผูก authenticator ใหม่
MFA_SECRET_KEY=CHANGE_ME
NATIONAL_ID_KEY=CHANGE_ME
NATIONAL_ID_KEYS_OLD=

# อยู่หลัง Nginx เสมอ — ไม่ตั้งแล้วทั้งวิทยาลัยแชร์ถังจำกัดคำขอใบเดียว
TRUST_PROXY=true
CORS_ORIGINS=https://vec.examkub.com

DEV_AUTH=false
MFA_DISABLED=false
THROTTLE_ENABLED=true
JWT_TTL=12h
LOG_LEVEL=info
LOGIN_LOG_KEEP_DAYS=90

# งานประจำคืนรันในโปรเซสนี้ — จึงรันได้ instance เดียวเท่านั้น
JOBS_ENABLED=true
