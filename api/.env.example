# คัดลอกเป็น .env แล้วแก้ค่า — อย่า commit ไฟล์ .env เข้ารีโป

# ── ฐานข้อมูล ──────────────────────────────────────────────────────
# ต้องเป็นผู้ใช้ที่อยู่ในกลุ่ม app_runtime และไม่ใช่ superuser
# ถ้าเป็น superuser แอปจะปฏิเสธการเริ่มทำงาน เพราะ RLS จะถูกข้ามทั้งหมด
DATABASE_URL=postgres://vecsms_app:PASSWORD@localhost:5432/vecsms
DB_POOL_MAX=10

# ── ความปลอดภัย ────────────────────────────────────────────────────
# สุ่มด้วย: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# เปิดเฉพาะเครื่องพัฒนา — ทำให้ POST /auth/dev-token ออก token ได้โดยไม่ต้องยืนยันตัวตน
# ระบบจริงต้องเป็น false และเปลี่ยนไปใช้ Google Workspace หรือ ThaID
DEV_AUTH=false

# ── ระบบ ───────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info

# ── งานตามกำหนดเวลา ───────────────────────────────────────────────
# คำนวณความเสี่ยงรายคืน · ปรับสถานะระงับสิทธิ์รายวัน · ล้างบันทึกการเข้าระบบ
#
# ตั้ง false เมื่อรันหลาย instance แล้วให้ตัวตั้งเวลาของแพลตฟอร์มยิงเข้า
# POST /jobs/run แทน มิฉะนั้นทุก instance จะรันงานเดียวกันพร้อมกัน
JOBS_ENABLED=true

# เวลาตามนาฬิกาของโปรเซส — ตั้ง TZ=Asia/Bangkok ด้วยถ้าเซิร์ฟเวอร์เป็น UTC
JOBS_DAILY_AT=01:30

# ระยะเก็บบันทึกการเข้าสู่ระบบ ต่ำกว่า 90 วันไม่ได้ตาม พ.ร.บ.คอมพิวเตอร์ มาตรา 26
# ค่าที่ต่ำกว่านี้จะถูกยกขึ้นเป็น 90 ให้อัตโนมัติ
LOGIN_LOG_KEEP_DAYS=90

# ── จำกัดจำนวนคำขอ ────────────────────────────────────────────────
# นับสองชั้นและต้องผ่านทั้งคู่ — ชั้นในหน่วยความจำของโปรเซส (เร็ว ไม่แตะ
# ฐานข้อมูล) กับชั้นในฐานข้อมูลที่นับรวมทุก instance
THROTTLE_ENABLED=true
THROTTLE_LIMIT=300
THROTTLE_WINDOW_SECS=60

# db (ค่าเริ่มต้น) = นับรวมทุก instance ผ่าน request_rate_hit() คิดเป็น
#                   หนึ่ง query ต่อคำขอที่ถูกจำกัด
# memory          = นับในหน่วยความจำอย่างเดียว เพดานจริงจะคูณตามจำนวน
#                   instance ตั้งได้เฉพาะเมื่อรัน instance เดียวจริง ๆ
#
# ค่าเริ่มต้นเป็น db เพราะเพดานที่เปลี่ยนไปเงียบ ๆ ตอน scale out แย่กว่า
# ค่าใช้จ่ายของอีกหนึ่ง query — เส้นทางที่ตั้งเพดานแน่นไว้คือเส้นทางที่
# อ่อนไหวที่สุด (เช่น POST /provisioning/institutions ที่ 3 ครั้งต่อนาที)
THROTTLE_STORE=db

# เชื่อ X-Forwarded-For เฉพาะเมื่ออยู่หลัง reverse proxy ที่เชื่อถือได้เท่านั้น
# ถ้าเปิดทั้งที่ไม่มี proxy ใครก็ปลอมเฮดเดอร์เพื่อให้ได้โควตาใหม่ทุกคำขอได้
TRUST_PROXY=false

# ── เพดานขนาดคำขอ ─────────────────────────────────────────────────
# ทั่วไปตั้งให้เล็ก เพราะคำขอใหญ่ ๆ ที่ยิงรัวคือวิธีทำให้เซิร์ฟเวอร์
# หมดหน่วยความจำที่ง่ายที่สุด ส่วนเส้นทางนำเข้าข้อมูลเปิดกว้างกว่า
# เพราะไฟล์นักศึกษาพันคนเป็น JSON ราว 150KB
BODY_LIMIT=256kb
IMPORT_BODY_LIMIT=8mb

# ── เพดานเวลาของคำสั่งฐานข้อมูล ───────────────────────────────────
# ไม่มีเพดานแปลว่า query ช้าตัวเดียวยึด connection ไว้ไม่ปล่อย
# คำขอช้าเท่าจำนวน pool = ระบบล่มทั้งตัวทั้งที่ฐานข้อมูลยังปกติ
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=30000

# ── เอกสาร OpenAPI ────────────────────────────────────────────────
# ปิดไว้ในระบบจริง เพราะรายการ endpoint ทั้งหมดพร้อมบทบาทที่เรียกได้
# เป็นแผนที่ให้ผู้โจมตีอย่างดี เปิดชั่วคราวเมื่อต้องใช้แล้วปิดกลับ
OPENAPI_ENABLED=false

# ทางออกฉุกเฉินสำหรับกรณีที่จำเป็นต้องรันด้วย superuser จริง ๆ เท่านั้น
# ห้ามเปิดในระบบจริง เพราะทำให้ RLS ไม่ทำงาน
# ALLOW_SUPERUSER=false

# ── เฉพาะตอนรันเทสต์ ───────────────────────────────────────────────
# ADMIN_DATABASE_URL ใช้เตรียมข้อมูลทดสอบด้วยสิทธิ์เจ้าของฐานข้อมูล
# ADMIN_DATABASE_URL=postgres://dbowner@localhost:5432/vecsms_api_test
