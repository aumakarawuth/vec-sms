# คัดลอกเป็น .env แล้วแก้ค่า — อย่า commit ไฟล์ .env เข้ารีโป
#   cp .env.example .env

# ── ฐานข้อมูล ──────────────────────────────────────────────────────
POSTGRES_DB=vecsms
POSTGRES_USER=vecsms
# สุ่มรหัสผ่านด้วย:  openssl rand -base64 32
POSTGRES_PASSWORD=

# พอร์ตบนเครื่องโฮสต์ เปลี่ยนถ้ามี Postgres ตัวอื่นใช้ 5432 อยู่แล้ว
DB_PORT=5432

# ไฟล์ที่จะนำเข้าตอนสร้าง container ครั้งแรก
#   vec-sms-full.sql    โครงสร้าง + ข้อมูลตัวอย่าง  (ทดลองใช้)
#   vec-sms-schema.sql  โครงสร้างอย่างเดียว        (ระบบจริง)
INIT_SQL=vec-sms-full.sql

# ── สำหรับ deploy.sh ไปเซิร์ฟเวอร์ปลายทาง ─────────────────────────
# DATABASE_URL=postgres://user:password@host:5432/vecsms
# บริการที่ต้องใช้ SSL เช่น Supabase หรือ Neon ให้เติม ?sslmode=require ท้าย URL

# ── pgAdmin (เปิดด้วย --profile tools) ─────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
